[Unit]
Description=Network Namespace Multicast Relay for rootless Podman UID %i
Documentation=https://github.com/mortezaPRK/netns-mcast-relay/tree/main/contrib/podman
After=network-online.target user@%i.service
Wants=network-online.target user@%i.service

[Service]
Type=exec
Environment=RELAY_SOCKET=/run/netns-mcast-relay/control.sock
Environment=PODMAN_SOCKET=/run/user/%i/podman/podman.sock
Environment=PODMAN_API_VERSION=v1.0.0
Environment=RELAY_ANNOTATION=io.github.mortezaprk.netns-mcast-relay
Environment=RELAY_ANNOTATION_VALUE=true
Environment=RECONCILE_ATTEMPTS=30
Environment=RECONCILE_RETRY_SECONDS=1

ExecStart=/usr/local/bin/relay \
  --group=224.0.0.251:5353 \
  --group=239.255.255.250:1900 \
  --ns=/proc/1/ns/net \
  --control-socket=${RELAY_SOCKET} \
  --control-socket-group=netns-mcast-relay \
  --control-socket-mode=0660
ExecStartPost=/usr/local/libexec/netns-mcast-relay/reconcile-podman.sh

Restart=on-failure
RestartSec=5s
Group=netns-mcast-relay
RuntimeDirectory=netns-mcast-relay
RuntimeDirectoryMode=0750

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
# Expose only the rootless API directory through the hidden /run/user tree.
BindReadOnlyPaths=/run/user/%i/podman
ReadWritePaths=/run/netns-mcast-relay
# Namespace paths in /proc require ptrace access checks, including /proc/1/ns/net.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_SYS_PTRACE
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK

[Install]
WantedBy=multi-user.target
